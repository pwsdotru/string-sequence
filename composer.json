{
  "name": "pwsdotru/string-sequence",
  "description": "Library for generate sequence from string description",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Aleksandr Novikov",
      "email": "pwsdotru@gmail.com",
      "homepage": "https://github.com/pwsdotru"
    }
  ],
  "keywords": [
    "sequence",
    "string"
  ],
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "12.*",
    "squizlabs/php_codesniffer": "4.*",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/extension-installer": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "StringSequence\\": "src/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit -c phpunit.xml",
    "style:check": "vendor/bin/phpcs",
    "style:fix": "vendor/bin/phpcbf",
    "analyse": "vendor/bin/phpstan analyse --ansi",
    "git:prepush": [
      "@style:check",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
